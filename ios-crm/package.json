{
  "name": "swh-crm",
  "version": "1.0.0",
  "description": "Capacitor iOS wrapper for the SWH CRM web app",
  "private": true,
  "scripts": {
    "sync": "npx cap sync",
    "sync:ios": "npx cap sync ios",
    "copy": "npx cap copy",
    "open:ios": "npx cap open ios",
    "doctor": "npx cap doctor",
    "postinstall": "sed -i '' 's/from: \"7.0.0\"/from: \"8.0.0\"/' node_modules/@capacitor-community/contacts/Package.swift 2>/dev/null || true"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^7.2.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ebarooni/capacitor-calendar": "^8.2.0",
    "@revenuecat/purchases-capacitor": "^13.1.1"
  }
}