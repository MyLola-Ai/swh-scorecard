rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'austen@austensmith.com'
           ];
    }

    // ── /users — user docs and all subcollections ──
    // Entitlement fields are server-write-only. Cloud Functions run as admin
    // and bypass rules entirely, so this only ever restricts direct browser
    // writes. Found 2026-08-13: an owner could set planOverride (checked
    // FIRST in computeEntitlement, no expiry) or plan (the legacy no-apple/
    // no-stripe branch reads it raw) directly and grant themselves paid
    // access, invisible in Stripe. Verified live against the deployed
    // ruleset and real Firestore data before this fix: 0 of 56 user docs had
    // planOverride set, 0 forged trialEndsAt -- not exploited.
    function entitlementFieldsUpdate() {
      return ['planOverride', 'plan', 'trial', 'trialEndsAt', 'trialStartedAt',
              'apple', 'stripe', 'currentPeriodEnd', 'cancelAtPeriodEnd',
              'teamId', 'teamRole', 'subscriptionStatus', 'stripeSubscriptionId',
              'stripeCustomerId', 'appleTransactionId'];
    }
    // create's own list omits 'plan': the real signup flow (both CRM and
    // Scorecard) stamps plan:'free' on first write, which is harmless (it's
    // the safe default anyway) -- checked explicitly below instead of
    // blocking the field outright, so a genuine first-time signup keeps
    // working unmodified.
    function entitlementFieldsCreate() {
      return ['planOverride', 'trial', 'trialEndsAt', 'trialStartedAt',
              'apple', 'stripe', 'currentPeriodEnd', 'cancelAtPeriodEnd',
              'teamId', 'teamRole', 'subscriptionStatus', 'stripeSubscriptionId',
              'stripeCustomerId', 'appleTransactionId'];
    }
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // First-time signup creates own doc -- but was completely unrestricted,
      // meaning a hand-crafted first write (bypassing the app's own signup
      // code, calling the SDK directly) could include planOverride:'pro' in
      // the SAME call and grant itself paid access on account #1. Now: any
      // entitlement field beyond plan is admin-only even on create, and plan
      // itself may only be 'free' (or omitted) -- matching exactly what the
      // real signup flow already sends, nothing else changes for it.
      allow create: if isOwner(uid)
                    && (isAdmin()
                        || (!request.resource.data.keys().hasAny(entitlementFieldsCreate())
                            && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')));
      // admin can still flip plan, etc.; an owner update may touch anything
      // EXCEPT the entitlement fields above -- those only ever move via a
      // Cloud Function (Stripe/RevenueCat webhooks, comp grants), which run
      // as admin and are unaffected by this rule.
      allow update: if (isOwner(uid) || isAdmin())
                    && (isAdmin()
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(entitlementFieldsUpdate()));
      allow delete: if isAdmin();

      // Catch-all for any subcollection (contacts, days, opportunities, config, lag, …)
      match /{subcoll}/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /{subcoll}/{docId}/{nested=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ── /announcements — any signed-in user reads; admin writes ──
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── /platform — global config (activity catalog, etc.) ──
    match /platform/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── /system — server/admin config (e.g. lolaConnect beta flag) ──
    // Read + written server-side (Admin SDK); admin may manage it directly.
    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    // ── /mail — Trigger Email Extension queue ──
    // Authed users can enqueue (signup notifications). Admin can blast.
    // Reads restricted to admin so users can't see each other's email payloads.
    match /mail/{id} {
      allow create: if isSignedIn();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── /teams — team plan workspaces ──
    // teams/{teamId}: owner-readable + member-readable; writes ONLY via Cloud Functions (admin SDK).
    // teams/{teamId}/members/{uid}: self-readable, owner-readable; writes admin-only.
    // teams/{teamId}/invites/{inviteId}: owner-readable; writes admin-only.
    // teams/{teamId}/feed/{eventId}: member-readable; writes admin-only.
    match /teams/{teamId} {
      function isTeamOwnerHere() {
        return isSignedIn() && resource.data.ownerUid == request.auth.uid;
      }
      function isTeamMemberHere() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      }
      allow read: if isAdmin() || isTeamOwnerHere() || isTeamMemberHere();
      allow create, update, delete: if isAdmin(); // Cloud Functions only

      match /members/{memberUid} {
        allow read: if isAdmin() || isOwner(memberUid) ||
          (isSignedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid);
        allow create, update, delete: if isAdmin();
      }

      match /invites/{inviteId} {
        allow read: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid);
        allow create, update, delete: if isAdmin();
      }

      match /feed/{eventId} {
        allow read: if isAdmin() ||
          (isSignedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)));
        allow create, update, delete: if isAdmin();
      }

      // Team Contact Awareness — shared duplicate-awareness index.
      // Docs are {uid}_{contactId} = { phoneNorm, ownerUid, ownerName, addedAt, contactId }.
      // Members may read (to see "a teammate is already working this number");
      // each member manages only entries they own. Backfill + wipe run through
      // Cloud Functions (admin SDK) when the team toggle flips.
      match /contactIndex/{entryId} {
        allow read: if isAdmin() || isTeamMemberHere();
        allow create: if isAdmin() ||
          (isTeamMemberHere() &&
           request.resource.data.ownerUid == request.auth.uid &&
           entryId == request.auth.uid + '_' + request.resource.data.contactId &&
           request.resource.data.phoneNorm is string &&
           request.resource.data.phoneNorm.size() >= 7 &&
           request.resource.data.phoneNorm.size() <= 10);
        allow update: if isAdmin() ||
          (isTeamMemberHere() &&
           resource.data.ownerUid == request.auth.uid &&
           request.resource.data.ownerUid == request.auth.uid &&
           request.resource.data.phoneNorm is string &&
           request.resource.data.phoneNorm.size() >= 7 &&
           request.resource.data.phoneNorm.size() <= 10);
        allow delete: if isAdmin() ||
          (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      }
    }

    // ── /teamInvites — short, queryable invite tokens for accept-flow ──
    // Indexed by token so an unauthenticated visitor can read minimal preview data
    // (team name, inviter name) before signing up. Writes only via Cloud Functions.
    match /teamInvites/{token} {
      allow read: if true; // token IS the secret — anyone with it can preview
      allow create, update, delete: if isAdmin();
    }

    // ── /waitlist — paywall email capture (no auth required) ──
    // Anonymous waitlist writes from demo users in WKWebView. Validation
    // in the rule prevents abuse: must have a string email matching basic
    // email shape, doc must be small.
    match /waitlist/{id} {
      allow create: if request.resource.data.email is string
                     && request.resource.data.email.size() < 200
                     && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                     && request.resource.data.size() < 10;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
